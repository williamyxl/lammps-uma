# UMA / omat Al fcc 3x3x3 single-point (Kokkos CUDA)
# Geometry: a = 4.05 * 1.01 Å, ideal sites

units           metal
atom_style      atomic
boundary        p p p

read_data       data.lmp

variable        uma_art string ../../uma-engine/artifacts/uma-s-1p2-omat

pair_style      uma/kk precision mixed
pair_coeff      * * ${uma_art} Al
newton          off

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

thermo          1
thermo_style    custom step pe etotal fmax fnorm
thermo_modify   norm no

dump            1 all custom 1 forces.dump id type x y z fx fy fz
dump_modify     1 sort id

run             0
print           "Final PE = $(pe)"
