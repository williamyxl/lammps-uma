# NaCl 5x5x5 rocksalt — short NVT smoke with pair_style uma/kk
#
# Launch (from this directory, after build_uma.slurm finishes):
#   ../../../../build-uma/lmp -k on g 1 -sf kk -in in.nacl5_nvt

units           metal
atom_style      atomic
boundary        p p p

# --- build NaCl rocksalt (a = 5.64 A): Na on FCC, Cl on FCC shifted ---
lattice         fcc 5.64
region          box block 0 5 0 5 0 5 units lattice
create_box      2 box
create_atoms    1 box
lattice         fcc 5.64 origin 0.5 0.5 0.5
create_atoms    2 box

mass            1 22.989769    # Na
mass            2 35.453       # Cl

# --- UMA (FP64). Artifact path is relative to this input file. ---
variable        uma_art string ../../uma-engine/artifacts/uma-s-1p2-omat-f64
pair_style      uma/kk precision double
pair_coeff      * * ${uma_art} Na Cl
newton          off

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# --- NVT @ 300 K, 10 steps (1 fs / step in metal units) ---
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
timestep        0.001

# NOTE: pair_style uma does not compute the virial (P0'.1), so requesting `press`
# in thermo_style would abort. Report energy quantities only.
thermo          1
thermo_style    custom step temp pe ke etotal
thermo_modify   norm no

run             10

print           "Done. Final T = $(temp) K, PE = $(pe) eV"
