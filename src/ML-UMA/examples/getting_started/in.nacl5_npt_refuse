# P0'.1 regression: pair_style uma must REFUSE to run when a global virial is
# requested (fix npt / fix nph / compute pressure / thermo press), rather than
# silently reporting a zero (kinetic-only) stress.
#
# EXPECTED: LAMMPS aborts at init_style (setup) with the error
#   "Pair style uma does not compute the virial; pressure control (fix ...) ..."
# A clean exit (status 0) is a FAILURE of this test. (Plain NVE/NVT and
# single-point runs are unaffected: only an active barostat is refused.)
#
# Launch:
#   ../../../../build-uma/lmp -k on g 1 -sf kk -in in.nacl5_npt_refuse
#   test -> must exit NONZERO with the virial-refusal message.

units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 5.64
region          box block 0 5 0 5 0 5 units lattice
create_box      2 box
create_atoms    1 box
lattice         fcc 5.64 origin 0.5 0.5 0.5
create_atoms    2 box

mass            1 22.989769
mass            2 35.453

variable        uma_art string ../../uma-engine/artifacts/uma-s-1p2-omat-f64
pair_style      uma/kk precision double
pair_coeff      * * ${uma_art} Na Cl
newton          off

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# --- request a barostat: this REQUIRES the virial and must be refused ---
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             1 all npt temp 300.0 300.0 0.1 iso 1.0 1.0 1.0
timestep        0.001

thermo          1
run             1

print           "FAIL: run completed; virial refusal did not trigger"
