# NaCl rocksalt 3x3x3, 10-step NPT with pair_style uma (ML-UMA)
#
# Requires a user-exported FP64 TorchScript artifact directory.
#   lmp -in in.nacl.npt -var uma_art /path/to/uma-s-1p2-omat-f64
#
# virial auto (default) turns on the strain-gradient virial when a
# barostat is present. ac off is required for that path.
# Do not use -k on / -sf kk. newton pair must be off.

variable        nsteps index 10
variable        uma_art index uma-s-1p2-omat-f64

units           metal
atom_style      atomic
boundary        p p p
newton          off

lattice         fcc 5.64
region          box block 0 3 0 3 0 3 units lattice
create_box      2 box
create_atoms    1 box
lattice         fcc 5.64 origin 0.5 0.5 0.5
create_atoms    2 box

mass            1 22.989769
mass            2 35.453

pair_style      uma precision double virial auto ac off decomp graph
pair_coeff      * * ${uma_art} Na Cl

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             1 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
timestep        0.001

thermo          1
thermo_style    custom step temp pe ke etotal press vol
thermo_modify   norm no

run             ${nsteps}
