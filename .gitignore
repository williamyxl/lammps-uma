# Reduced-precision (.extxyz, %.8f) geometries are NOT tracked: the full-precision
# LAMMPS .data is the single authoritative geometry source for all tests. Mixing
# an 8-digit extxyz with a 16-digit .data inflated water888 |dE| by ~1e-7 eV.
src/ML-UMA/examples/multi_gpu_nacl6/structures/nacl6_rattle_fixed.extxyz
src/ML-UMA/examples/water888/water_nvt_300K.extxyz
# Full-precision extxyz derived on-the-fly from .data by the P0 MP export.
src/ML-UMA/uma-engine/artifacts/**/_p0_geom/

# PBS job stdout/stderr logs (Polaris: <jobname>.o<id> / .e<id>)
*.o[0-9]*
*.e[0-9]*
# P0 job result dirs (regenerated per run)
src/ML-UMA/examples/polaris_p0/results/
# uma-engine C++ build trees
src/ML-UMA/uma-engine/build-cpp-mp/
src/ML-UMA/uma-engine/build-cpp-mp-*/

# vendored NCCL lib is a symlink into the conda env (regenerate via env_polaris)
src/ML-UMA/uma-engine/third_party/nccl/lib/
# M3 results + derived geometry
src/ML-UMA/examples/polaris_m3/results/

# core dumps from OOM/killed runs
core.[0-9]*
# built managed allocator (regenerate via nvcc in the PBS job)
src/ML-UMA/examples/polaris_m3/libmanaged_alloc.so
# UMA paper PDF (large binary reference, not source)
src/ML-UMA/*.pdf

# P3.2: PBS job outputs / scratch — never commit run artifacts.
scripts/out/
scripts/*.o[0-9]*
scripts/*.e[0-9]*
*.o[0-9]*
# PBS -k doe stdout files land in the submit dir with the job name
par_gate.o[0-9]*
final_pp.o[0-9]*
rebuild.o[0-9]*
p1_agfd.o[0-9]*
virial*.o[0-9]*
# ld-compat shims created by gate jobs
scripts/**/compat/

