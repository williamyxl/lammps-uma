#!/bin/bash -le
#PBS -l select=1:system=polaris:ncpus=64:ngpus=4
#PBS -l walltime=0:30:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -N gp_force_diag
#PBS -A RAPINS
set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"; ROOT="$(pwd)"; source "${ROOT}/polaris/env_polaris.sh"
ENG="${ROOT}/src/ML-UMA/uma-engine"; M3="${ROOT}/src/ML-UMA/examples/polaris_m3"; P0="${ROOT}/src/ML-UMA/examples/polaris_p0"
export PYTHONPATH="${P0}:${ENG}/python:${PYTHONPATH:-}"; export TMPDIR="/tmp/t_$USER"; mkdir -p "$TMPDIR"
OUT="${M3}/results/gp_force_diag_${PBS_JOBID}"; mkdir -p "$OUT"
N=6; python "${M3}/make_nacl_data.py" --n $N --out "${OUT}/n$N.data"
echo "=== serial 1-GPU ref (ground truth) ==="
CUDA_VISIBLE_DEVICES=0 python "${M3}/serial_ref.py" --data "${OUT}/n$N.data" --out "${OUT}/serial.npz"
echo "=== real torch.distributed GP (4-GPU) via ase_ckpt_ref ==="
export MASTER_ADDR=127.0.0.1 MASTER_PORT=$((29500+RANDOM%400))
OFI=/soft/libraries/aws-ofi-nccl/v1.6.0-libfabric-1.22.0
[[ -e "$OFI/lib/libnccl-net.so" ]] && export LD_LIBRARY_PATH="$OFI/lib:/opt/cray/libfabric/2.2.0rc1/lib64:$LD_LIBRARY_PATH"
export FI_CXI_DEFAULT_CQ_SIZE=131072 FI_MR_CACHE_MONITOR=userfaultfd NCCL_CROSS_NIC=1
mpiexec -n 4 --ppn 4 "${ROOT}/polaris/gpu_affinity_polaris.sh" python "${M3}/ase_ckpt_ref.py" --data "${OUT}/n$N.data" --out "${OUT}/dist_gp.npz" || echo "dist gp failed"
echo "=== compare ==="
python - "$OUT" <<'PY'
import sys,numpy as np; from pathlib import Path
d=Path(sys.argv[1]); sr=np.load(d/"serial.npz")
print("serial E",float(sr["energy_eV"]),"fmax",np.abs(sr["forces"]).max())
gp=d/"dist_gp.npz"
if gp.is_file():
    g=np.load(gp); dF=np.linalg.norm(g["forces"]-sr["forces"],axis=1)
    print("dist-GP E",float(g["energy_eV"]),"dE",abs(float(g["energy_eV"])-float(sr["energy_eV"])))
    print("dist-GP max|dF| vs serial =",dF.max(),"mean",dF.mean())
PY
echo "GP_FORCE_DIAG_DONE $OUT"
