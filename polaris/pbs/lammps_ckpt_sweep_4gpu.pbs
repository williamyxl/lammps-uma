#!/bin/bash -le
#PBS -l select=1:system=polaris:ncpus=64:ngpus=4
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -N lmp_ckpt_sweep
#PBS -A RAPINS

# N=20..25 in LAMMPS + activation checkpointing on 4 GPUs (eager native GP
# worker). For each N: LAMMPS-UMA SP (E + per-atom F) + short NVT timing, and an
# ASE-FairChem FP64 checkpointing oracle (general recipe, 4-GPU GP) for E/F
# comparison. All bit-exact recipe (general) so LAMMPS vs ASE should match to the
# FP64 floor.

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
ROOT="$(pwd)"
source "${ROOT}/polaris/env_polaris.sh"
ENG="${ROOT}/src/ML-UMA/uma-engine"
M3="${ROOT}/src/ML-UMA/examples/polaris_m3"
P0="${ROOT}/src/ML-UMA/examples/polaris_p0"
export PYTHONPATH="${P0}:${ENG}/python:${PYTHONPATH:-}"
ART="${UMA_ARTIFACT_DIR}"; LMP="${ROOT}/build-uma-mn/lmp"
OUT="${M3}/results/lmp_ckpt_sweep_${PBS_JOBID:-manual}"; mkdir -p "${OUT}"
export TMPDIR="/tmp/t_$USER"; mkdir -p "${TMPDIR}"
NVT="${M3_NVT_STEPS:-10}"
SIZES="${M3_SIZES:-20 21 22 23 24 25}"

# native GP worker uses host-staged collectives (no Ray/NCCL); enable multi-GPU.
export UMA_EAGER_CKPT=1
export UMA_PYTHON_GP_WORKER=1
export UMA_LIBTORCH_MP_WORKER="${ENG}/build-cpp-mp-mn/uma_libtorch_mp_worker"

for N in ${SIZES}; do
  echo "############################ N=${N} ############################"
  DATA="${OUT}/nacl${N}.data"
  python "${M3}/make_nacl_data.py" --n ${N} --out "${DATA}"

  # ---- LAMMPS-UMA + checkpointing (4 GPU) ----
  cat > "${OUT}/in.${N}" <<EOF
units metal
atom_style atomic
boundary p p p
newton off
read_data ${DATA}
pair_style uma precision double devices 4
pair_coeff * * ${ART} Na Cl
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.001
thermo 1
thermo_style custom step temp pe
thermo_modify norm no format float %.17g
dump 1 all custom 1 ${OUT}/lmp_f_${N}.dump id type x y z fx fy fz
dump_modify 1 sort id format float %.17g
run 0
undump 1
print "SP_PE_${N} = \$(pe:%.17g)"
velocity all create 300.0 12345 mom yes rot yes dist gaussian
fix 1 all nvt temp 300.0 300.0 \$(100.0*dt)
run ${NVT}
print "NVT_PE_${N} = \$(pe:%.17g)"
EOF
  echo "== LAMMPS+ckpt N=${N} =="
  "${LMP}" -in "${OUT}/in.${N}" -log "${OUT}/log.${N}" > "${OUT}/out.${N}" 2>&1
  echo "  lmp rc=$? $(grep -h "SP_PE_${N}" "${OUT}/out.${N}" "${OUT}/log.${N}" 2>/dev/null | grep -oE '=-?[0-9.]+' | head -1)"
  grep -iE "out of memory|ERROR" "${OUT}/out.${N}" 2>/dev/null | head -2 || true

  # ---- ASE-FC FP64 checkpointing oracle (4 GPU GP), general recipe ----
  echo "== ASE-FC ckpt oracle N=${N} =="
  export MASTER_ADDR=127.0.0.1 MASTER_PORT=$((29500+RANDOM%500))
  OFI=/soft/libraries/aws-ofi-nccl/v1.6.0-libfabric-1.22.0
  [[ -e "$OFI/lib/libnccl-net.so" ]] && export LD_LIBRARY_PATH="$OFI/lib:/opt/cray/libfabric/2.2.0rc1/lib64:$LD_LIBRARY_PATH"
  export FI_CXI_DEFAULT_CQ_SIZE=131072 FI_MR_CACHE_MONITOR=userfaultfd NCCL_CROSS_NIC=1
  mpiexec -n 4 --ppn 4 "${ROOT}/polaris/gpu_affinity_polaris.sh" \
    python "${M3}/ase_ckpt_ref.py" --data "${DATA}" --out "${OUT}/ase_${N}.npz" || \
    echo "  (ASE N=${N} failed/OOM)"
done

echo "=== PARITY + TIMING REPORT ==="
python "${M3}/lmp_ckpt_report.py" --outdir "${OUT}" --sizes ${SIZES} || true
echo "LMP_CKPT_SWEEP_DONE ${OUT}"
