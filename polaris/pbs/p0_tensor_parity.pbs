#!/bin/bash -le
#PBS -l select=1:system=polaris
#PBS -l walltime=0:30:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -N p0_tensor
#PBS -A RAPINS

# P0 tensor-level parity: in-process FairChem vs traced-artifact+autograd on the
# identical AtomicData graph. No LAMMPS, no dump, no %g -> isolates FP64
# reduction-order from output formatting. Writes P0_TENSOR_PARITY.{md,json}.

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
ROOT="$(pwd)"
source "${ROOT}/polaris/env_polaris.sh"

export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
P0="${ROOT}/src/ML-UMA/examples/polaris_p0"
export PYTHONPATH="${P0}:${ENG}/python:${PYTHONPATH:-}"

test -f "${UMA_ARTIFACT_DIR}/model_traced.pt" || { echo "P0_FAIL missing artifact"; exit 1; }

python "${P0}/p0_tensor_parity.py" --systems nacl666 water888 --recipes general fastmerge
echo "P0_TENSOR_RC=$?"
