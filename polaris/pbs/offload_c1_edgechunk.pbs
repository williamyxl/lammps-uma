#!/bin/bash -le
#PBS -l select=1:system=polaris:ncpus=64:ngpus=4
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -N offload_c1_edge
#PBS -A RAPINS

# C1: edge chunking (edge_chunk_size). Does streaming edges add capacity, alone
# and stacked with checkpointing? Eager sweep (edge_chunk affects the O(50N)
# edge memory).

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
ROOT="$(pwd)"
source "${ROOT}/polaris/env_polaris.sh"
export CUDA_VISIBLE_DEVICES=0
M3="${ROOT}/src/ML-UMA/examples/polaris_m3"
export PYTHONPATH="${ROOT}/src/ML-UMA/examples/polaris_p0:${ENG}/python:${PYTHONPATH:-}"
OUT="${M3}/results/offload_c1_${PBS_JOBID:-manual}"; mkdir -p "${OUT}"

echo "############ C1: edge_chunk alone (no ckpt) ############"
python "${M3}/max_atoms_sweep.py" --ckpt "${UMA_CHECKPOINT}" --checkpointing 0 \
  --edge-chunk 65536 --sizes 6 8 10 12 --out "${OUT}/c1_edge_only.json" || true

echo "############ C1+ckpt: edge_chunk + checkpointing ############"
python "${M3}/max_atoms_sweep.py" --ckpt "${UMA_CHECKPOINT}" --checkpointing 1 \
  --edge-chunk 65536 --sizes 12 16 20 24 --out "${OUT}/c1_edge_ckpt.json" || true

echo "=== SUMMARY ==="
python - "${OUT}" <<'PY'
import json,sys; from pathlib import Path
d=Path(sys.argv[1])
for f in ["c1_edge_only.json","c1_edge_ckpt.json"]:
    p=d/f
    if p.is_file():
        s=json.loads(p.read_text()); print(f"{s['tag']}: max_atoms_fit={s['max_atoms_fit']}")
PY
echo "OFFLOAD_C1_DONE ${OUT}"
