#!/bin/bash -le
#PBS -l select=1:system=polaris:ncpus=64:ngpus=4
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:eagle:grand
#PBS -q debug
#PBS -N cap_sweep_4gpu
#PBS -A RAPINS

# Max NaCl NxNxN that fits on 4 GPUs (aggregate memory) with activation
# checkpointing, via FairChem graph-parallel (workers=4). Sweep N=8..20.

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
ROOT="$(pwd)"
source "${ROOT}/polaris/env_polaris.sh"
# all 4 GPUs visible for FairChem GP
unset CUDA_VISIBLE_DEVICES
M3="${ROOT}/src/ML-UMA/examples/polaris_m3"
export PYTHONPATH="${ROOT}/src/ML-UMA/examples/polaris_p0:${ENG}/python:${PYTHONPATH:-}"
OUT="${M3}/results/cap_sweep_4gpu_${PBS_JOBID:-manual}"; mkdir -p "${OUT}"

# FairChem workers>1 uses Ray, whose AF_UNIX socket path must be < 107 bytes.
# The default PBS TMPDIR is far too long -> use a short /tmp path. Also allow Ray
# GP here (this measurement needs FairChem's eager multi-GPU).
export RAY_TMPDIR="/tmp/ray_$USER"; mkdir -p "${RAY_TMPDIR}"
export TMPDIR="/tmp/t_$USER"; mkdir -p "${TMPDIR}"
export UMA_FORBID_RAY_GP=0
export UMA_ALLOW_RAY_GP=1
# Ray-on-one-node stability knobs (the connect crash is usually GCS/dashboard).
export RAY_DISABLE_DOCKER_CPU_WARNING=1
export RAY_DEDUP_LOGS=0
unset RAY_ADDRESS 2>/dev/null || true
export RAY_DISABLE_IMPORT_WARNING=1
export RAY_START_REDIS_WAIT_RETRIES=60
# bind Ray to the node's high-speed loopback; avoid hostname resolution issues
export RAY_OVERRIDE_NODE_IP_ADDRESS="127.0.0.1"

echo "############ 4 GPU + checkpointing, NaCl N=8..20 ############"
python "${M3}/max_atoms_sweep.py" --ckpt "${UMA_CHECKPOINT}" \
  --checkpointing 1 --workers 4 \
  --sizes 8 10 12 14 16 18 20 \
  --out "${OUT}/sweep_4gpu_ckpt.json"

echo "=== SUMMARY ==="
python - "${OUT}" <<'PY'
import json,sys; from pathlib import Path
s=json.loads((Path(sys.argv[1])/"sweep_4gpu_ckpt.json").read_text())
print(f"{s['tag']}: max_atoms_fit={s['max_atoms_fit']}")
PY
echo "CAP_SWEEP_4GPU_DONE ${OUT}"
