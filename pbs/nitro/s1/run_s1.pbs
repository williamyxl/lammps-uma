#!/bin/bash -l
#PBS -N nitro-s1
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
#PBS -o /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
#PBS -e /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
# Step 12 (S1). The binary is compiled on the login node.
# Submit from pbs/nitro/s1.
set -uo pipefail
HERE="${PBS_O_WORKDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
REL="$(cd "${HERE}/../../.." && pwd)"
# shellcheck disable=SC1091
source "${REL}/pbs/nitro/env.inc"
BIN="${REL}/pbs/out/s1_build/s1_test"
[[ -x "${BIN}" ]] || { echo "S1_FAIL missing ${BIN}"; exit 1; }
echo "S1_JOB host=$(hostname) job=${PBS_JOBID:-none}"
icpx --version | head -2 || true
echo "--- ldd sycl ---"
ldd "${BIN}" | grep -E 'sycl|ur_loader' || true
"${BIN}"
rc=$?
python - <<PY
import json, pathlib
meta = {
  "step": 12,
  "name": "S1",
  "job": "${PBS_JOBID:-none}",
  "host": "$(hostname)",
  "rc": ${rc},
}
path = pathlib.Path("${REL}/pbs/out/nitro_s1_${PBS_JOBID:-manual}")
path.mkdir(parents=True, exist_ok=True)
(path / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
print("META", path / "meta.json")
PY
echo "S1_JOB_DONE rc=${rc}"
exit "${rc}"
