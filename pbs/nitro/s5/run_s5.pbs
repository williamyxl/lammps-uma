#!/bin/bash -l
#PBS -N nitro-s5
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
#PBS -o /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
#PBS -e /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
# Step 17 (S5). The binary is compiled on the login node.
# Submit from pbs/nitro/s5.
set -uo pipefail
HERE="${PBS_O_WORKDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
REL="$(cd "${HERE}/../../.." && pwd)"
# shellcheck disable=SC1091
source "${REL}/pbs/nitro/env.inc"
export PATH="${MPICH}/bin:${PATH}"
export TORCH_XPU_ARCH_LIST="${TORCH_XPU_ARCH_LIST:-pvc}"
BIN="${REL}/pbs/out/s5_build/s5_test"
[[ -x "${BIN}" ]] || { echo "S5_FAIL missing ${BIN}"; exit 1; }
echo "S5_JOB host=$(hostname) job=${PBS_JOBID:-none}"
icpx --version | head -2 || true
echo "--- ldd sycl ---"
ldd "${BIN}" | grep -E 'sycl|ur_loader' || true
mpiexec -n 1 --ppn 1 gpu_tile_compact.sh "${BIN}"
rc=$?
echo "S5_JOB_DONE rc=${rc}"
exit "${rc}"
