#!/bin/bash -l
#PBS -N nitro-n1b
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
#PBS -o /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
#PBS -e /lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma-nitro/pbs/out/
# Step 16 (N1-b) selftest. The binary is compiled on the login node.
# Submit from pbs/nitro/n1b.
set -uo pipefail
HERE="${PBS_O_WORKDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
REL="$(cd "${HERE}/../../.." && pwd)"
# shellcheck disable=SC1091
source "${REL}/pbs/nitro/env.inc"
export PATH="${MPICH}/bin:${PATH}"
export UMA_NITRO_N1B=1
BIN="${REL}/pbs/out/n1b_build/n1_selftest"
[[ -x "${BIN}" ]] || { echo "N1B_SELFTEST_FAIL missing ${BIN}"; exit 1; }
echo "N1B_JOB host=$(hostname) job=${PBS_JOBID:-none}"
mpiexec -n 1 --ppn 1 gpu_tile_compact.sh "${BIN}"
rc=$?
echo "N1B_JOB_DONE rc=${rc}"
exit "${rc}"
