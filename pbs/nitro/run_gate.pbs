#!/bin/bash -l
#PBS -N nitro-gate
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
#PBS -o ../out/
#PBS -e ../out/
# ---------------------------------------------------------------------------
# lammps-uma-nitro gate: build (per-commit dir) + export + NaCl 14^3 (or ZIF-8 3x3x3) W=12 FP64
# NVT and NPT, 10 steps, with a force dump at steps 0 and 10.
# Pass bar: |dPE| < 1e-8 eV against the recorded Wave E / Wave 0 values.
#
# Submit from this directory (queue debug or debug-scaling only):
#   cd pbs/nitro && qsub -v NITRO_TAG=nitro/base-verify/r1 run_gate.pbs
# Optional:
#   NITRO_ART=<dir>        reuse an existing W=12 artifact instead of re-exporting
#   NITRO_REF=<dir>        same as NITRO_ART, but the path is never deleted
#   NITRO_SKIP_BUILD=1     reuse an existing build for this commit
#   KEEP_ARTIFACT=1        keep an artifact this job exported (default: delete at exit)
#   NITRO_EXPORT_RANKS=1   export one rank (microbenchmarks); default is W=12
#   NITRO_SYSTEM=zif8      ZIF-8 3x3x3 instead of NaCl 14^3 (same protocol; see systems.inc).
#                          With no recorded reference PE the job runs record-only (no bar).
# ---------------------------------------------------------------------------
set -uo pipefail
HERE="${NITRO_HERE:-${PBS_O_WORKDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}}"
[[ -f "${HERE}/env.inc" ]] || { echo "NITRO_FAIL: run qsub from pbs/nitro (or set NITRO_HERE)"; exit 1; }
REL="$(cd "${HERE}/../.." && pwd)"
# shellcheck disable=SC1091
source "${HERE}/lib.inc"
nitro_check_tree

SHA7=$(git -C "${REL}" rev-parse --short=7 HEAD)
export NITRO_BUILD="${REL}/build-nitro/${SHA7}"
# shellcheck disable=SC1091
source "${HERE}/env.inc"

W=12
PPN=12
NSTEPS=10
CHUNK=65536
# Reference PEs come from systems.inc (NaCl: recorded Wave 0 / Wave E values).
REF_STEP0_PE="${SYS_REF_STEP0_PE}"
REF_NVT_PE10="${SYS_REF_NVT_PE10}"
REF_NPT_PE10="${SYS_REF_NPT_PE10}"
TOL=1e-8
RECORD_ONLY=0
[[ -n "${REF_STEP0_PE}" && -n "${REF_NVT_PE10}" && -n "${REF_NPT_PE10}" ]] || RECORD_ONLY=1

OUTROOT="${REL}/pbs/out/nitro_gate_${PBS_JOBID:-manual}"
RUNDIR="${OUTROOT}/${SYS_DIR}"
mkdir -p "${RUNDIR}"
nitro_install_cleanup_trap
# NITRO_REF is a read-only input. It is never marked owned, so the exit trap
# cannot delete it. NITRO_ART is the same reuse path.
if [[ -n "${NITRO_REF:-}" && -z "${NITRO_ART:-}" ]]; then
  NITRO_ART="${NITRO_REF}"
fi
if [[ -n "${NITRO_ART:-}" ]]; then
  ART="${NITRO_ART}"
  ART_KEPT=yes
else
  ART="${RUNDIR}/artifact"
  ART_KEPT=no
  [[ "${KEEP_ARTIFACT:-0}" == "1" ]] && ART_KEPT=yes
fi

echo "NITRO_GATE host=$(hostname) job=${PBS_JOBID:-none} REL=${REL} sha=${SHA7} queue=${PBS_QUEUE:-unknown}"
python -c "import torch; assert '+xpu' in torch.__version__, torch.__version__; print('TORCH_OK', torch.__version__)"

module load cmake 2>/dev/null || true
nitro_require_mpich
export CC="${GCC_PREFIX:-/opt/aurora/26.181.0/spack/unified/1.1.1/install/linux-x86_64/gcc-13.4.0-22p27zg}/bin/gcc"
export CXX="${GCC_PREFIX:-/opt/aurora/26.181.0/spack/unified/1.1.1/install/linux-x86_64/gcc-13.4.0-22p27zg}/bin/g++"

if [[ "${NITRO_SKIP_BUILD:-0}" == "1" && -x "${LMP}" ]]; then
  echo "BUILD_SKIPPED reuse ${LMP}"
else
  nitro_cmake_build
fi
[[ -x "${LMP}" ]] || nitro_die "missing lmp ${LMP}"
echo "BUILD_OK ${LMP}"
grep -E 'vesin|XCCL' "${OUTROOT}/cmake.log" 2>/dev/null | head -5 || true

echo "NITRO_SYSTEM=${NITRO_SYSTEM} (${SYS_LABEL}) record_only=${RECORD_ONLY}"
nitro_make_cell "${RUNDIR}" || nitro_die "cell generation failed for ${NITRO_SYSTEM}"
NAT="$(awk '/atoms/{print $1; exit}' "${RUNDIR}/${SYS_DATA}")"

if [[ -n "${NITRO_ART:-}" ]]; then
  [[ -f "${ART}/metadata.json" ]] || nitro_die "NITRO_ART has no metadata.json: ${ART}"
  echo "EXPORT_REUSED ${ART}"
else
  rm -rf "${ART}"
  nitro_own_artifact "${ART}"
  export EDGE_AC_CHUNK="${CHUNK}"
  echo "EXPORT_RANKS $(nitro_export_world)"
  nitro_export_artifact "$(nitro_export_world)"
fi

export UMA_MP_NATOMS="${NAT}"
nitro_runtime_env

# qsub -v UMA_NITRO_N1=1 is visible here, but nitro_run_ens only forwards
# NITRO_SLOT_ENV into the LAMMPS process.
if [[ "${UMA_NITRO_N1:-}" == "1" ]]; then
  NITRO_SLOT_ENV="UMA_NITRO_N1=1"
  export NITRO_SLOT_ENV
  echo "N1_ARM on"
fi

nitro_write_in nvt "fix             1 all nvt temp 300.0 300.0 0.1" "${NSTEPS}" "${NSTEPS}"
nitro_write_in npt "fix             1 all npt temp 300.0 300.0 0.1 iso 1.01325 1.01325 1.0" "${NSTEPS}" "${NSTEPS}"

nvt_rc=0 npt_rc=0
nitro_run_ens nvt && nvt_rc=0 || nvt_rc=$?
nitro_run_ens npt && npt_rc=0 || npt_rc=$?

pe_ok=0
if [[ "${nvt_rc}" -eq 0 && "${npt_rc}" -eq 0 && "${RECORD_ONLY}" -eq 1 ]]; then
  echo "RECORD_ONLY: no reference PE for ${NITRO_SYSTEM}; record these values in systems.inc (step 10, Z1.4)"
  for ens in nvt npt; do
    for st in 0 ${NSTEPS}; do
      python "${HERE}/compare.py" pe "${RUNDIR}/log.${ens}" "${st}" || pe_ok=1
    done
  done
elif [[ "${nvt_rc}" -eq 0 && "${npt_rc}" -eq 0 ]]; then
  python "${HERE}/compare.py" bar "${RUNDIR}/log.nvt" 0  "${REF_STEP0_PE}" "${TOL}" || pe_ok=1
  python "${HERE}/compare.py" bar "${RUNDIR}/log.npt" 0  "${REF_STEP0_PE}" "${TOL}" || pe_ok=1
  python "${HERE}/compare.py" bar "${RUNDIR}/log.nvt" 10 "${REF_NVT_PE10}" "${TOL}" || pe_ok=1
  python "${HERE}/compare.py" bar "${RUNDIR}/log.npt" 10 "${REF_NPT_PE10}" "${TOL}" || pe_ok=1
else
  pe_ok=1
fi

# The checkpoint path under hen/uma-cache is allowed and appears in the log; only
# the hen code root (UMA_HEN_ROOT) or hen python paths are forbidden.
if grep -qE 'UMA_HEN_ROOT|hen/(patches|shim|scripts)' "${RUNDIR}/lmp.nvt.log" 2>/dev/null; then
  echo "WARN: hen code reference seen in lmp.nvt.log (gate requires none)"
  pe_ok=1
fi
python "${HERE}/compare.py" perf "${RUNDIR}/lmp.nvt.log" 5 > "${OUTROOT}/perf_nvt.json" 2>/dev/null || true
python "${HERE}/meta.py" "${OUTROOT}" "${REL}" --lmp "${LMP}" --artifact "${ART}" \
  --tag "${NITRO_TAG}" --log "${RUNDIR}/lmp.nvt.log" \
  --artifact-kept "${ART_KEPT}" \
  --extra "system=${NITRO_SYSTEM}" "nat=${NAT}" "W=${W}" "nsteps=${NSTEPS}" "mpich=${MPICH}" || nitro_die "meta.py failed"

{
  echo "NITRO_ART=${ART}"
  echo "NITRO_LMP=${LMP}"
  echo "NITRO_NAT=${NAT}"
  echo "NITRO_SYSTEM=${NITRO_SYSTEM}"
  echo "NITRO_GIT_SHA=$(git -C "${REL}" rev-parse HEAD)"
  echo "NITRO_OUTROOT=${OUTROOT}"
} > "${OUTROOT}/run.env"

SUM="${OUTROOT}/SUMMARY.txt"
{
  echo "gate job=${PBS_JOBID:-none} system=${NITRO_SYSTEM} tag=${NITRO_TAG} sha=${SHA7} nat=${NAT} W=${W} nsteps=${NSTEPS}"
  echo "nvt_rc=${nvt_rc} npt_rc=${npt_rc} pe_ok=${pe_ok}"
  echo "lmp=${LMP}"
  echo "artifact=${ART} artifact_kept=${ART_KEPT}"
  echo "----- fairchem -----"
  nitro_fairchem_note || true
  echo "----- NVT thermo tail -----"
  tail -14 "${RUNDIR}/log.nvt" 2>/dev/null || true
  echo "----- NPT thermo tail -----"
  tail -14 "${RUNDIR}/log.npt" 2>/dev/null || true
} > "${SUM}"
echo "NITRO_GATE_DONE nvt_rc=${nvt_rc} npt_rc=${npt_rc} pe_ok=${pe_ok} ${OUTROOT}"
if [[ "${nvt_rc}" -ne 0 || "${npt_rc}" -ne 0 || "${pe_ok}" -ne 0 ]]; then
  exit 1
fi
exit 0
