#!/bin/bash -l
#PBS -N p6_mrun
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe

# Pre-fix max-N baseline RUN: 12-tile XCCL GP step-0 (FP64) at descending N; the
# largest N with exit=0 (energy printed) = current max-N before the per-block fix.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
ART=${LU}/scripts/out/phase6_shards/uma-s-1p2-omat-f64-gp
OUTDIR=${LU}/scripts/out/phase6_maxN; mkdir -p "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat_libs; mkdir -p "${COMPAT}"
ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi

NLIST="${NLIST:-16 14 12}"
BEST=0
for N in ${NLIST}; do
  nat=$((8*N*N*N))
  have=$(ls ${ART}/model_mp_w12_n${nat}_r*.pt 2>/dev/null | wc -l)
  if [ "${have}" -ne 12 ]; then echo "N=${N}: shards ${have}/12, skip"; continue; fi
  echo "=== run N=${N} (${nat} atoms) 12-tile step-0 ==="
  OUTDIR="${OUTDIR}" ART="${ART}" N=${N} W=12 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null
  R="${OUTDIR}/nacl_n${N}_w12"
  t0=$SECONDS
  ( cd "${R}" && mpiexec -n 12 --ppn 12 \
      env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${nat} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
      gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  rc=$?; dt=$((SECONDS-t0))
  pe=$(grep -E '^\s*0\s' "${R}/log.lammps" 2>/dev/null | head -1 | awk '{print $3}')
  oom=$(grep -c "out of memory\|OUT_OF_RESOURCES" "${R}/lmp.log" 2>/dev/null)
  echo "N=${N} exit=${rc} wall=${dt}s PE=${pe:-none} oom_lines=${oom}"
  if [ "${rc}" -eq 0 ] && [ -n "${pe}" ]; then BEST=${N}; echo "N=${N} OK -> MAX so far ${BEST}"; break; fi
done
echo "MAX_N_NO_OOM=${BEST} atoms=$((8*BEST*BEST*BEST))"
echo "DONE p6_mrun"
