#!/bin/bash -l
#PBS -N p6_scaleW
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# N=18 scaling: one W (from env W). Export N=18 AC artifacts for all ranks of W
# (balance-fix), run pair_style uma on W tiles, record wall time + ASE parity.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
W=${W:-2}
ART=${LU}/scripts/out/phase6_scale/n18_ac        # w{W}/r{R} subdirs
OUTDIR=${LU}/scripts/out/phase6_scale/w${W}; mkdir -p "${OUTDIR}" "${ART}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CKPT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt" UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both EDGE_AC_CHUNK=16384
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"

echo "=== export N=18 AC artifacts, W=${W}, all ranks (balance-fix) ==="
for R in $(seq 0 $((W-1))); do
  [ -f "${ART}/w${W}/r${R}/model_traced.pt" ] && { echo "r${R} exists"; continue; }
  OUT="${ART}" N_LIST=18 EXPORT_WORLD=${W} EXPORT_RANK=${R} TRACE_DEV=xpu RECONSTRUCT=0 \
    python -u "${ENG}/python/export_blocks_xpu.py" >"${OUTDIR}/exp_r${R}.log" 2>&1
  echo "  r${R}: $([ -f ${ART}/w${W}/r${R}/model_traced.pt ] && echo OK || echo FAIL)"
done
# root metadata for pair_uma
[ -f "${ART}/w${W}/r0/metadata.json" ] && cp "${ART}/w${W}/r0/metadata.json" "${ART}/metadata.json"
echo "ranks: $(ls -d ${ART}/w${W}/r*/model_traced.pt 2>/dev/null | wc -l)/${W}"

echo "=== gen inputs + run N=18 on W=${W} tiles ==="
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi
R18=${OUTDIR}/run; mkdir -p "${R18}"
OUTDIR="${R18}" ART="${ART}" N=18 W=1 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${R18}/*/in.sp 2>/dev/null | head -1))
if [ "${W}" -eq 1 ]; then
  # single tile: devices 1, artifact = single-tile AC dir (no w/r). Use the p1b N=18 artifact.
  ART1=${LU}/scripts/out/phase6_h_p1b/blocks_n18
  sed -i "s#pair_coeff.*#pair_coeff      * * ${ART1} Na Cl#" ${RD}/in.sp
  t0=$SECONDS
  ( cd "${RD}" && mpiexec -n 1 --ppn 1 env ZE_AFFINITY_MASK=0 UMA_CHECKPOINT="${UMA_CHECKPOINT}" LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" "${LMP}" -in in.sp > lmp.log 2>&1 )
  rc=$?; WALL=$((SECONDS-t0))
else
  t0=$SECONDS
  ( cd "${RD}" && mpiexec -n ${W} --ppn ${W} env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=46656 LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  rc=$?; WALL=$((SECONDS-t0))
fi
echo "W=${W} N=18 exit=${rc} wall=${WALL}s :: $(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1)"
grep -iE "out of memory|OUT_OF|abort|error" ${RD}/lmp.log | grep -vi index_reduce | head -3
echo "=== parity vs ASE ==="
DIR="${RD}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
  python -u "${LU}/scripts/phase5_parity.py" 2>&1 | grep -vi index_reduce | tail -5
echo "SCALE_RESULT W=${W} wall=${WALL}s"
echo "DONE"
