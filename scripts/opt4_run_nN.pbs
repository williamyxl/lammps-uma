#!/bin/bash -l
#PBS -N o4_runN
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# opt-stack run at arbitrary N on 12 tiles: NVT 300K 10 steps. Runs TWO configs
# back to back on the opt2 EDGE_AC_CHUNK=65536 frozen artifacts:
#   (A) baseline stack (opt1+opt2+opt3): full checkpointing
#   (B) + opt4 partial no-recompute (UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1)
# so we see whether opt4 fits and how much it helps at this N. Reports wall/Loop/
# energy/OOM for each. N from env (default 38). Uses the already-built lmp with
# the granular no-recompute knobs.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
N=${N:-38}; NAT=$((8*N*N*N))
ART=${ART:-${LU}/scripts/out/opt2/n${N}_chunk65536}
OUTDIR=${LU}/scripts/out/opt4run_n${N}; mkdir -p "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "LMP MISSING"; exit 1; }
NR=$(ls -d ${ART}/w12/r*/model_traced.pt 2>/dev/null|wc -l)
[ "${NR}" -ge 12 ] || { echo "N=${N} artifacts ${NR}/12 MISSING at ${ART}"; exit 1; }
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi
[ -f "${ART}/w12/r0/metadata.json" ] && cp "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
echo "N=${N} atoms=${NAT} ART=${ART} ranks=${NR}/12"

run_cfg () {
  local tag="$1"; shift; local nrenv="$1"; shift
  local RB=${OUTDIR}/${tag}; mkdir -p "${RB}"
  OUTDIR="${RB}" ART="${ART}" N=${N} W=1 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
  local RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))
  echo "=== [${tag}] N=${N} W=12 NVT 10 steps  NR=[${nrenv}] ==="
  local t0=$SECONDS
  ( cd "${RD}" && mpiexec -n 12 --ppn 12 env ${nrenv} UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  local rc=$?; local WALL=$((SECONDS-t0))
  local LOOP=$(grep -oE 'Loop time of [0-9.]+ .* for 10 steps' ${RD}/log.lammps 2>/dev/null|grep -oE '[0-9.]+'|head -1)
  local OOM=$(grep -icE "out of memory|OUT_OF" ${RD}/lmp.log 2>/dev/null)
  local PE=$(python3 - "${RD}/log.lammps" 2>/dev/null <<'PYEOF'
import re,sys
try: txt=open(sys.argv[1]).read()
except: sys.exit()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
if not m: sys.exit()
hdr=m.group(0).split(); pe=hdr.index("PotEng"); last=None
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s and s[0].isdigit(): last=s
if last: print(f"{float(last[pe]):.6f}")
PYEOF
)
  echo "RESULT tag=${tag} exit=${rc} oom=${OOM} wall=${WALL}s loop=${LOOP}s step10_PE=${PE}"
  [ "${OOM}" -gt 0 ] && grep -iE "out of memory" ${RD}/lmp.log | grep -vi index_reduce | head -1
}

run_cfg "baseline_ckpt" ""
run_cfg "opt4_partial"  "UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1"
echo "N=${N} ref: prior AC N=38 NVT baseline was 800 s (edge_ac_chunk=16384, no opt2/opt3)"
echo "DONE"
