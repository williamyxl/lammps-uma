#!/bin/bash -l
#PBS -N p6_mxN12
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# Max-N on 12 tiles: export 12 per-rank AC artifacts at N (env), run on 12 tiles,
# record wall + ASE parity. SKIP existing ranks (resume across jobs).
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
N=${N:-32}; W=12
ART=${LU}/scripts/out/phase6_maxN12/n${N}_ac
OUTDIR=${LU}/scripts/out/phase6_maxN12/w12_n${N}; mkdir -p "${OUTDIR}" "${ART}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CKPT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt" UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both EDGE_AC_CHUNK=16384
export UMA_EXPORT_CELL_LIST=1
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
NAT=$((8*N*N*N))
echo "=== export N=${N} (${NAT} atoms) W=12 per-rank AC ==="
for R in $(seq 0 11); do
  [ -f "${ART}/w12/r${R}/model_traced.pt" ] && continue
  OUT="${ART}" N_LIST=${N} EXPORT_WORLD=12 EXPORT_RANK=${R} TRACE_DEV=xpu RECONSTRUCT=0 \
    python -u "${ENG}/python/export_blocks_xpu.py" >"${OUTDIR}/exp_r${R}.log" 2>&1
  echo "  r${R}: $([ -f ${ART}/w12/r${R}/model_traced.pt ] && echo OK || echo FAIL)"
done
NR=$(ls -d ${ART}/w12/r*/model_traced.pt 2>/dev/null | wc -l)
echo "ranks: ${NR}/12"
[ "${NR}" -ne 12 ] && { echo "INCOMPLETE export (resume in next job)"; exit 0; }
[ -f "${ART}/w12/r0/metadata.json" ] && cp "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
echo "=== run N=${N} on 12 tiles ==="
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi
RB=${OUTDIR}/run; mkdir -p "${RB}"
OUTDIR="${RB}" ART="${ART}" N=${N} W=1 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null | head -1))
t0=$SECONDS
( cd "${RD}" && mpiexec -n 12 --ppn 12 env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
rc=$?; WALL=$((SECONDS-t0))
echo "N=${N} W=12 exit=${rc} wall=${WALL}s :: $(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1)"
grep -iE "out of memory|OUT_OF|abort" ${RD}/lmp.log | grep -vi index_reduce | head -2
echo "=== parity vs ASE ==="
DIR="${RD}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
  python -u "${LU}/scripts/phase5_parity.py" 2>&1 | grep -vi index_reduce | tail -5
echo "MAXN12_RESULT N=${N} atoms=${NAT} exit=${rc} wall=${WALL}s"
echo "DONE"
