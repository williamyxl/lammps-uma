#!/bin/bash -l
#PBS -N p21_r24
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -k doe
# P2.1 decisive test: N=24 W=12 NVT 300K 10 steps (previously CRASHED at step 1
# with "Expected 18 elements in a list but found 19"). With edge padding it must
# now complete all 10 steps. C1 path. step-0 PE must be -373517.77 (ASE-GP match).
set +u
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
N=24; NAT=$((8*N*N*N))
ART=${LU}/scripts/out/p21/n24_chunk65536
OUTDIR=${LU}/scripts/out/p21run/n24; mkdir -p "${OUTDIR}"
source "${HEN}/scripts/activate_fxpu.sh"
set -euo pipefail
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "LMP MISSING"; exit 1; }
[ "$(ls -d ${ART}/w12/r*/model_traced.pt 2>/dev/null|wc -l)" -ge 12 ] || { echo "artifacts MISSING"; exit 1; }
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd \
       CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi
cp -f "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
RB=${OUTDIR}/run; mkdir -p "${RB}"
OUTDIR="${RB}" ART="${ART}" N=${N} W=12 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))
echo "=== P2.1 N=24 W=12 NVT 10 steps (was: crash at step 1) ==="
t0=$SECONDS
set +e
( cd "${RD}" && mpiexec -n 12 --ppn 12 env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} \
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
rc=$?; set -e
WALL=$((SECONDS-t0))
echo "exit=${rc} wall=${WALL}s"
echo "=== thermo (need steps 0..10) ==="
grep -E "^\s*(0|1|5|10)\s" ${RD}/log.lammps 2>/dev/null | head -6
echo "=== any chunk error? ==="
grep -iE "Expected .* elements|out of memory|abort" ${RD}/lmp.log 2>/dev/null | grep -vi index_reduce | head -3 || echo "  (none)"
python3 - "${RD}/log.lammps" <<'PYEOF'
import re,sys
try: txt=open(sys.argv[1]).read()
except: sys.exit()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
if not m: print("no thermo"); sys.exit()
hdr=m.group(0).split(); pe=hdr.index("PotEng"); rows={}
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s and s[0].isdigit(): rows[int(s[0])]=float(s[pe])
if 0 in rows:
    e0=rows[0]; ref=-373517.77
    print(f"  step0 PE={e0:.6f} (ASE-GP ref {ref:.2f}, dE={abs(e0-ref):.3e})")
last=max(rows) if rows else -1
print(f"  last completed step = {last}  (need 10)")
print(f"  P2.1 {'PASS: 10-step NVT completed' if last>=10 else 'FAIL: did not reach step 10'}")
PYEOF
echo "DONE"
