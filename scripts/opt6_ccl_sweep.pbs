#!/bin/bash -l
#PBS -N o6_ccl
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:50:00
#PBS -j oe
#PBS -k doe
# opt6: tune small-message all_reduce latency (15 tiny all_reduces/step dominate
# N=16, ~45%). Pure XCCL env -> parity-neutral. Sweep CCL_ALLREDUCE algo at
# N=16 W=12 (fast K=3). Compare Loop + ms_allreduce + step0 parity.
set +u
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine; LMP=${LU}/build-lmp-xccl/lmp
N=16; NAT=$((8*N*N*N)); ART=${LU}/scripts/out/n16_fast
OUTDIR=${LU}/scripts/out/opt6ccl; mkdir -p "${OUTDIR}"
source "${HEN}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi
cp -f "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
run () {
  local TAG=$1; shift; local EXTRA="$*"
  local RB=${OUTDIR}/${TAG}; mkdir -p "${RB}"
  OUTDIR="${RB}" ART="${ART}" N=${N} W=12 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
  local RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))
  ( cd "${RD}" && mpiexec -n 12 --ppn 12 env UMA_MP_PERF=1 ${EXTRA} \
      UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1 UMA_CHUNK_RETAIN_K=3 UMA_SKIP_MAXNBR_CAP=1 \
      UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
      gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  local LOOP=$(grep -oE 'Loop time of [0-9.]+ .* for 10 steps' ${RD}/log.lammps 2>/dev/null|grep -oE '[0-9.]+'|head -1)
  local AR=$(grep "MP_PERF rank=0 " ${RD}/lmp.log 2>/dev/null | tail -1 | grep -oE 'ms_allreduce=[0-9.]+')
  local PE0=$(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1|awk '{print $3}')
  echo "O6CCL ${TAG} loop=${LOOP}s ${AR} step0=${PE0}  [${EXTRA}]"
}
run baseline ""
run rd    "CCL_ALLREDUCE=recursive_doubling"
run direct "CCL_ALLREDUCE=direct"
run ring   "CCL_ALLREDUCE=ring"
run rd_pidfd "CCL_ALLREDUCE=recursive_doubling CCL_ZE_IPC_EXCHANGE=pidfd"
echo "(baseline ~12.8s; step0 ref -110673.829050)"
echo DONE
