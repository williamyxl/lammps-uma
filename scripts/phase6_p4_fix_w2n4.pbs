#!/bin/bash -l
#PBS -N p6_p4fix
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# P4 AC+GP correctness fix validation: W=2 N=4 (512 atoms).
# Re-export W=2 (r0,r1) AND W=1 N=4 AC artifacts (Python-only balance-natoms fix),
# then run pair_style uma on 2 tiles + 1 tile and compare energy/forces vs the
# Gate1 target (-1729.366821) and the ASE oracle. NO C++ rebuild (fix is in
# export_blocks_xpu.py); reuse existing lmp (AC merge).
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
ART=${LU}/scripts/out/phase6_p4_fix/blocks_ac_gp   # gets w2/r{R}/ and w1/r0/ (W=1 written to root)
OUTDIR=${LU}/scripts/out/phase6_p4_fix; mkdir -p "${ART}" "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "LMP MISSING"; exit 1; }
echo "LMP OK (reuse, Python-only fix)"
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export UMA_CKPT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both EDGE_AC_CHUNK=16384
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi

echo "=== export W=2 N=4 AC artifacts (r0,r1) + W=1 N=4 (balance-natoms fix) ==="
for R in 0 1; do
  ZE_AFFINITY_MASK=0 OUT="${ART}" N_LIST=4 EXPORT_WORLD=2 EXPORT_RANK=${R} TRACE_DEV=xpu RECONSTRUCT=0 \
    python -u "${ENG}/python/export_blocks_xpu.py" >"${OUTDIR}/exp_w2_r${R}.log" 2>&1
  echo "  w2 r${R}: $([ -f ${ART}/w2/r${R}/model_traced.pt ] && echo OK || echo FAIL) $(grep -E 'GRAPH-STRUCTURE|Traceback|Error:' ${OUTDIR}/exp_w2_r${R}.log | tail -1)"
done
# W=1 single-tile AC reference (writes to ART root)
ZE_AFFINITY_MASK=0 OUT="${ART}" N_LIST=4 EXPORT_WORLD=1 EXPORT_RANK=0 TRACE_DEV=xpu RECONSTRUCT=1 \
  python -u "${ENG}/python/export_blocks_xpu.py" >"${OUTDIR}/exp_w1.log" 2>&1
echo "  w1: $([ -f ${ART}/model_traced.pt ] && echo OK || echo FAIL) $(grep -E 'RECONSTRUCT|Traceback|Error:' ${OUTDIR}/exp_w1.log | tail -1)"

# root metadata.json (C++ reads it from the ART root); copy from w2/r0.
cp -f "${ART}/w2/r0/metadata.json" "${ART}/metadata.json"

echo "=== gen inputs N=4 W=2 and W=1 ==="
R2=${OUTDIR}/run_w2; R1=${OUTDIR}/run_w1
OUTDIR="${R2}" ART="${ART}" N=4 W=2 NVT_STEPS=0 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
OUTDIR="${R1}" ART="${ART}" N=4 W=1 NVT_STEPS=0 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD2=$(dirname $(ls ${R2}/*/in.sp 2>/dev/null | head -1))
RD1=$(dirname $(ls ${R1}/*/in.sp 2>/dev/null | head -1))
echo "rd2=${RD2} rd1=${RD1}"

echo "=== 1-tile N=4 run (mpiexec -n 1) ==="
( cd "${RD1}" && mpiexec -n 1 --ppn 1 \
    env UMA_CHECKPOINT="${UMA_CHECKPOINT}" LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
    gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
echo "1-tile exit=$? :: $(grep -E '^\s*0\s' ${RD1}/log.lammps 2>/dev/null | head -1)"
grep -iE "AC-shard|loaded .*block|xccl.*ready|out of memory|OUT_OF|abort" ${RD1}/lmp.log | grep -vi index_reduce | head -4

echo "=== 2-tile N=4 GP run (mpiexec -n 2, XCCL, AC) ==="
( cd "${RD2}" && mpiexec -n 2 --ppn 2 \
    env UMA_CHECKPOINT="${UMA_CHECKPOINT}" LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
    gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
echo "2-tile exit=$? :: $(grep -E '^\s*0\s' ${RD2}/log.lammps 2>/dev/null | head -1)"
grep -iE "AC-shard|loaded .*block|xccl.*ready|out of memory|OUT_OF|abort" ${RD2}/lmp.log | grep -vi index_reduce | head -6

echo "=== Gate1 compare (W=2 vs W=1 vs ASE) ==="
DIR1="${RD1}" DIR2="${RD2}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
  python -u "${LU}/scripts/phase6_gate1_compare.py" 2>&1 | grep -vi index_reduce | tail -12

echo "=== Gate1 target check (E_w2 vs -1729.366821) ==="
python3 - "${RD2}/log.lammps" <<'PYEOF'
import re,sys
txt=open(sys.argv[1]).read()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
hdr=m.group(0).split(); pe=hdr.index("PotEng")
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s[0]=="0":
        e=float(s[pe]); tgt=-1729.366821
        print(f"E_w2={e:.6f}  target={tgt:.6f}  dE={abs(e-tgt):.3e}  {'PASS' if abs(e-tgt)<1e-4 else 'FAIL'}")
        break
PYEOF
echo "DONE"
