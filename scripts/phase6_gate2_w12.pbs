#!/bin/bash -l
#PBS -N p6_g2w12
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe

# Phase-6 Gate 2 (12-tile): 18x18x18 NaCl (46,656 atoms) on 12 XPU tiles via
# native XCCL GP. Run pair_style uma (devices 1, mpiexec -n 12), step-0 energy +
# per-atom force dump, then parity vs ASE oracle + AG=FD.

module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
ART=${LU}/scripts/out/phase6_shards/uma-s-1p2-omat-f64-gp
OUTDIR=${LU}/scripts/out/phase6_gate2
mkdir -p "${OUTDIR}"

source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "MISSING ${LMP}"; exit 1; }

TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat_libs; mkdir -p "${COMPAT}"
ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi

echo "=== gen inputs N=18 W=12 ==="
OUTDIR="${OUTDIR}" ART="${ART}" N=18 W=12 python -u "${LU}/scripts/phase6_make_gp_inputs.py"
R="${OUTDIR}/nacl_n18_w12"

echo "=== run 18^3 on 12 tiles (XCCL GP) ==="
t0=$SECONDS
( cd "${R}" && mpiexec -n 12 --ppn 12 \
    env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=46656 LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
    gpu_tile_compact.sh \
    "${LMP}" -in in.sp > lmp.log 2>&1 )
rc=$?
echo "  12-tile exit=${rc} wall=$((SECONDS-t0))s :: $(grep -E '^\s*0\s' "${R}/log.lammps" 2>/dev/null | head -1)"
grep -iE "xccl.*ready|out of memory|OUT_OF|Segmentation|abort|error" "${R}/lmp.log" | head -5

echo "=== parity vs ASE oracle (energy + per-atom force, >=100 atoms) ==="
DIR="${R}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
  python -u "${LU}/scripts/phase5_parity.py" 2>&1 | tail -8

echo "=== AG=FD on 12-tile GP (10 atoms) ==="
export LMP_LAUNCH="mpiexec -n 12 --ppn 12 env UMA_CHECKPOINT=${UMA_CHECKPOINT} UMA_MP_NATOMS=46656 LD_LIBRARY_PATH=${LD_LIBRARY_PATH} gpu_tile_compact.sh ${LMP} -in \$INFILE > \$LOGFILE 2>&1"
DIR="${R}" W=12 FD_EPS=1e-4 AG_FD_TOL=1e-5 FD_SAMPLE=10 \
  python -u "${LU}/scripts/phase6_agfd.py" 2>&1 | tail -4

echo "DONE p6_g2w12"
