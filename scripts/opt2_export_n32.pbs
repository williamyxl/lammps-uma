#!/bin/bash -l
#PBS -N opt2_e32
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# opt2 export: N=32 W=12 AC artifacts with opt2 freeze ON (default) and
# EDGE_AC_CHUNK=65536 (== opt1). Writes to a SEPARATE dir so the validated
# opt1 baseline (scripts/out/opt1/n32_chunk65536) is untouched.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
ART=${LU}/scripts/out/opt2/n32_chunk${EDGE_AC_CHUNK:-65536}
mkdir -p "${ART}"
source "${HEN}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0 HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CKPT="${HEN}/uma-cache/uma-s-1p2.pt" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both UMA_EXPORT_CELL_LIST=1
export EDGE_AC_CHUNK=${EDGE_AC_CHUNK:-65536}
echo "=== opt2 export N=32 W=12 AC, EDGE_AC_CHUNK=${EDGE_AC_CHUNK} freeze=ON ==="
for R in $(seq 0 11); do
  [ -f "${ART}/w12/r${R}/model_traced.pt" ] && continue
  OUT="${ART}" N_LIST=32 EXPORT_WORLD=12 EXPORT_RANK=${R} TRACE_DEV=xpu RECONSTRUCT=0 \
    python -u "${ENG}/python/export_blocks_xpu.py" >"${ART}/exp_r${R}.log" 2>&1
  echo "  r${R}: $([ -f ${ART}/w12/r${R}/model_traced.pt ] && echo OK || echo FAIL) $(grep -E 'opt2:|GRAPH-STRUCTURE|Error:' ${ART}/exp_r${R}.log | tail -2 | tr '\n' ' ')"
done
[ -f "${ART}/w12/r0/metadata.json" ] && cp "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
echo "ranks: $(ls -d ${ART}/w12/r*/model_traced.pt 2>/dev/null|wc -l)/12"
echo "=== opt2 top-module size vs opt1 baseline (r0) ==="
OSZ=$(stat -c%s "${ART}/w12/r0/model_traced.pt" 2>/dev/null || echo 0)
BSZ=$(stat -c%s "${LU}/scripts/out/opt1/n32_chunk65536/w12/r0/model_traced.pt" 2>/dev/null || echo 0)
python3 -c "o=${OSZ}; b=${BSZ}; print(f'  opt2 ={o/1048576:.1f} MB  opt1 ={b/1048576:.1f} MB  saved/rank={(b-o)/1048576:.1f} MB ({(1-o/b)*100 if b else 0:.1f}%)')"
echo "  opt2 r0 total:  $(du -sh ${ART}/w12/r0 2>/dev/null|cut -f1)  (opt1 r0 = 4.4G)"
echo "  opt2 w12 total: $(du -sh ${ART}/w12 2>/dev/null|cut -f1)  (opt1 w12 = 53G)"
echo "DONE"
