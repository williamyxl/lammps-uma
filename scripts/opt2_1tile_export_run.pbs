#!/bin/bash -l
#PBS -N o2_1t_er
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
# Single-tile (W=1) opt2 export + C1/C2 run for N in 6 12 18.
# Exports W=1 opt2 frozen artifacts (EDGE_AC_CHUNK=65536, RECONSTRUCT=1) into
# scripts/out/opt2/n${N}_chunk65536_1tile/ for each N, then runs 10-step NVT
# 300K in both C1 (full checkpoint) and C2 (UMA_NO_RECOMPUTE_BLOCK=1
# UMA_NO_RECOMPUTE_EDEG=1) with mpiexec -n 1.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
source "${HEN}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "LMP MISSING"; exit 1; }
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
OUTDIR=${LU}/scripts/out/1tile_c1c2; mkdir -p "${OUTDIR}"
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ZE_AFFINITY_MASK=0 HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN}/uma-cache/uma-s-1p2.pt"
export UMA_CKPT="${HEN}/uma-cache/uma-s-1p2.pt" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both
export EDGE_AC_CHUNK=65536

run_1tile () {
  local N=$1 NAT=$((8*$1*$1*$1)) ART=$2
  local RB=${OUTDIR}/n${N}; mkdir -p "${RB}"
  OUTDIR="${RB}" ART="${ART}" N=${N} W=1 NVT_STEPS=10 \
    python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
  local RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null | head -1))

  for CFG in baseline_ckpt opt4_partial; do
    local NR_ENV=""
    [ "${CFG}" = "opt4_partial" ] && NR_ENV="UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1"
    local RUN_OUT=${OUTDIR}/n${N}_${CFG}; mkdir -p "${RUN_OUT}"
    cp -r "${RD}"/* "${RUN_OUT}/" 2>/dev/null
    local t0=$SECONDS
    ( cd "${RUN_OUT}" && mpiexec -n 1 --ppn 1 env ${NR_ENV} \
        UMA_CHECKPOINT="${UMA_CHECKPOINT}" LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
        gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
    local rc=$?; local WALL=$((SECONDS-t0))
    local LOOP=$(grep -oE 'Loop time of [0-9.]+ .* for 10 steps' ${RUN_OUT}/log.lammps 2>/dev/null | grep -oE '[0-9.]+'|head -1)
    local OOM=$(grep -icE "out of memory|OUT_OF|UR_RESULT_ERROR" ${RUN_OUT}/lmp.log 2>/dev/null)
    local PE=$(python3 - "${RUN_OUT}/log.lammps" 2>/dev/null <<'PYEOF'
import re,sys
try: txt=open(sys.argv[1]).read()
except: sys.exit()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
if not m: sys.exit()
hdr=m.group(0).split(); pe=hdr.index("PotEng"); last=None
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s and s[0].isdigit(): last=s
if last: print(f"{float(last[pe]):.6f}")
PYEOF
)
    echo "RESULT N=${N} tag=${CFG} exit=${rc} oom=${OOM} wall=${WALL}s loop=${LOOP}s PE=${PE}"
  done
}

for N in 6 12 18; do
  ART=${LU}/scripts/out/opt2/n${N}_chunk65536_1tile
  mkdir -p "${ART}"
  if [ ! -f "${ART}/model_traced.pt" ]; then
    echo "=== export N=${N} W=1 ==="
    OUT="${ART}" N_LIST=${N} EXPORT_WORLD=1 EXPORT_RANK=0 TRACE_DEV=xpu RECONSTRUCT=1 \
      python -u "${ENG}/python/export_blocks_xpu.py" > "${ART}/exp.log" 2>&1
    rc=$?
    echo "  N=${N}: $([ -f ${ART}/model_traced.pt ] && echo OK || echo FAIL) $(grep -E 'opt2:|RECONSTRUCT|Error:' ${ART}/exp.log | tail -2 | tr '\n' ' ')"
    [ $rc -ne 0 ] && grep "Traceback\|Error:" "${ART}/exp.log" | tail -3
  else
    echo "=== N=${N} W=1 already exported, skip ==="
  fi
  echo "=== run N=${N} 1-tile C1 + C2 ==="
  run_1tile ${N} "${ART}"
done

echo "DONE"
