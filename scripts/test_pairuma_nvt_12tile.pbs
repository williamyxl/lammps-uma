#!/bin/bash -l
#PBS -N t_pc12
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# Path C 12-tile: pair_style uma NVT 300K 10 steps, N from env (18/24/32).
# ART dir from env. First-frame parity vs ASE (N<=18 only), AG=FD, walltime.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
N=${N:-18}; NAT=$((8*N*N*N))
ART=${ART:?set ART}
OUTDIR=${LU}/scripts/out/test3path/pairuma_12tile/n${N}; mkdir -p "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi
[ -f "${ART}/w12/r0/metadata.json" ] && cp "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
RB=${OUTDIR}/run; mkdir -p "${RB}"
OUTDIR="${RB}" ART="${ART}" N=${N} W=1 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))
echo "=== run pair_style uma NVT N=${N} (12 tiles) ==="
t0=$SECONDS
( cd "${RD}" && mpiexec -n 12 --ppn 12 env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
rc=$?; WALL=$((SECONDS-t0))
echo "N=${N} 12-tile exit=${rc} wall=${WALL}s :: $(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1)"
grep -iE "out of memory|OUT_OF|abort" ${RD}/lmp.log | grep -vi index_reduce | head -2
# thermo: did 10 NVT steps complete?
echo "NVT last step: $(grep -E '^\s*10\s' ${RD}/log.lammps 2>/dev/null|tail -1)"
if [ "${N}" -le 18 ]; then
  echo "=== first-frame parity vs ASE ==="
  DIR="${RD}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
    python -u "${LU}/scripts/phase5_parity.py" 2>&1 | grep -vi index_reduce | grep -E "natoms|dE=|max.dF|gates" | tail -3
  echo "=== AG=FD (12-tile GP, 10 atoms) ==="
  export LMP_LAUNCH="mpiexec -n 12 --ppn 12 env UMA_CHECKPOINT=${UMA_CHECKPOINT} UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH=${LD_LIBRARY_PATH} gpu_tile_compact.sh ${LMP} -in \$INFILE > \$LOGFILE 2>&1"
  DIR="${RD}" W=12 FD_EPS=1e-4 AG_FD_TOL=1e-5 FD_SAMPLE=10 python -u "${LU}/scripts/phase6_agfd.py" 2>&1 | grep -E "AG=FD" | tail -1
else
  echo "(N>18: ASE single-tile oracle OOMs; walltime + energy only)"
fi
echo "PAIRUMA12_RESULT N=${N} atoms=${NAT} exit=${rc} wall=${WALL}s"
echo "DONE"
