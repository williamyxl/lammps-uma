#!/bin/bash -l
#PBS -N uma_gpnpt_x
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
# ---------------------------------------------------------------------------
# GP NPT validation at a SMALL size that fits UMA_AC=off: export an N=8 W=12 GP
# artifact (341 atoms/tile), then run 12-tile NPT with UMA_AC=off and confirm a
# finite nonzero pressure (the all-reduced GP virial is live). N=32 W=12 OOMs
# under AC-off (job 8816620) -- that only proved the barostat is accepted; this
# proves the virial actually computes.
#
#   qsub scripts/gp_npt_export_smoke.pbs
# ---------------------------------------------------------------------------
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128

LU=${LU:-/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma}
HEN=${HEN:-/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen}
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LMP:-${LU}/build-lmp-xccl/lmp}
N=${N:-8}
W=${W:-12}
NAT=$((8*N*N*N))
ART=${ART:-${LU}/scripts/out/gp_n8_w12}
STEPS=${STEPS:-3}
RUNDIR=${RUNDIR:-${LU}/scripts/out/gp_npt_smoke_n${N}}; mkdir -p "${RUNDIR}" "${ART}"

source "${HEN}/scripts/activate_fxpu.sh"
set -uo pipefail   # AFTER activation (conda mpivars not nounset-safe)
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "missing lmp"; exit 1; }
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${RUNDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
SYS_FABRIC=$(ls -d /opt/cray/libfabric/*/lib64 2>/dev/null | sort -V | tail -1)
export LD_LIBRARY_PATH="${SYS_FABRIC}:${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT=${UMA_CKPT:-${HEN}/uma-cache/uma-s-1p2.pt}
export UMA_CKPT="${UMA_CHECKPOINT}" UMA_TASK=omat
export FXPU_WIGNER_PREP_CHUNK=65536 FXPU_WIGNER_PREP_CHUNK_MODE=both UMA_EXPORT_CELL_LIST=1
export EDGE_AC_CHUNK=${EDGE_AC_CHUNK:-65536}

echo "### export GP N=${N} W=${W} (per-rank, serial on tile 0) ###"
for R in $(seq 0 $((W-1))); do
  [ -f "${ART}/w${W}/r${R}/model_traced.pt" ] && { echo "  r${R}: present"; continue; }
  OUT="${ART}" N_LIST=${N} EXPORT_WORLD=${W} EXPORT_RANK=${R} TRACE_DEV=xpu RECONSTRUCT=0 \
    ZE_AFFINITY_MASK=0 python -u "${ENG}/python/export_blocks_xpu.py" \
    > "${ART}/exp_r${R}.log" 2>&1
  echo "  r${R}: $([ -f ${ART}/w${W}/r${R}/model_traced.pt ] && echo OK || echo FAIL)"
done
NR=$(ls -d ${ART}/w${W}/r*/model_traced.pt 2>/dev/null | wc -l)
echo "ranks exported: ${NR}/${W}"
[ "${NR}" -eq "${W}" ] || { echo "EXPORT INCOMPLETE"; tail -8 ${ART}/exp_r0.log; exit 1; }
cp -f "${ART}/w${W}/r0/metadata.json" "${ART}/metadata.json"

# CCL runtime env for the 12-tile run
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd \
       CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi
unset ZE_AFFINITY_MASK

python - "${N}" "${RUNDIR}/data.nacl" <<'PY'
import sys, numpy as np
N=int(sys.argv[1]); out=sys.argv[2]; a=5.64; rng=np.random.default_rng(0)
base=np.array([[0,0,0],[0.5,0.5,0],[0.5,0,0.5],[0,0.5,0.5]])
Na=[];Cl=[]
for i in range(N):
 for j in range(N):
  for k in range(N):
   o=np.array([i,j,k])
   for b in base:
    Na.append((o+b)*a); Cl.append((o+b+np.array([0.5,0,0]))*a)
pos=np.array(Na+Cl); typ=[1]*len(Na)+[2]*len(Cl); pos+=rng.normal(0,0.05,pos.shape); L=N*a
with open(out,'w') as f:
 f.write(f"NaCl {N}\n\n{len(pos)} atoms\n2 atom types\n0 {L} xlo xhi\n0 {L} ylo yhi\n0 {L} zlo zhi\n\nMasses\n\n1 22.989769\n2 35.453\n\nAtoms\n\n")
 for idx,(p,t) in enumerate(zip(pos,typ),1): f.write(f"{idx} {t} {p[0]:.6f} {p[1]:.6f} {p[2]:.6f}\n")
PY

cat > "${RUNDIR}/in.gpnpt" <<EOF
units           metal
atom_style      atomic
boundary        p p p
newton          off
read_data       data.nacl
mass            1 22.989769
mass            2 35.453
pair_style      uma precision double devices 1
pair_coeff      * * ${ART} Na Cl
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001
velocity        all create 300.0 4928459 mom yes rot yes dist gaussian
fix             1 all npt temp 300.0 300.0 0.1 iso 1.0 1.0 1.0
thermo          1
thermo_style    custom step temp pe etotal press pxx pyy pzz
thermo_modify   norm no
run             ${STEPS}
EOF

cd "${RUNDIR}"
echo "### GP NPT: N=${N} W=${W} (${NAT} atoms, ${NAT}/${W}=$((NAT/W))/tile), UMA_AC=off, ${STEPS} steps ###"
mpiexec -n ${W} --ppn ${W} gpu_tile_compact.sh \
  env UMA_ALLOW_LEGACY_METADATA=1 UMA_AC=off UMA_MP_NATOMS=${NAT} \
  UMA_CHECKPOINT="${UMA_CHECKPOINT}" \
  "${LMP}" -in in.gpnpt > lmp.log 2>&1
echo "lmp exit=$?"
echo "=== thermo (step temp pe etotal press pxx pyy pzz) ==="
grep -E "^\s+[0-9]+\s" log.lammps 2>/dev/null | head -5
echo "=== checks ==="
if grep -qiE "does not compute the virial|not supported there" lmp.log; then echo "  FAIL: barostat refused"
elif grep -qiE "out of memory|OUT_OF_RESOURCES" lmp.log; then echo "  OOM (unexpected at N=${N})"; grep -iE "out of|allocate" lmp.log|head -2
else
  P0=$(grep -E "^\s+0\s" log.lammps 2>/dev/null | head -1 | awk '{print $5}')
  NST=$(grep -cE "^\s+[0-9]+\s" log.lammps 2>/dev/null)
  echo "  step0 Press=${P0:-<none>}  thermo_lines=${NST}"
  python - "${P0:-nan}" "${NST:-0}" <<'PY'
import sys
try: p=float(sys.argv[1])
except: p=float('nan')
n=int(sys.argv[2])
ok = (p==p) and abs(p)>1e-6 and n>=2
print("  PASS: GP NPT live -- finite nonzero pressure, >=2 steps" if ok else
      f"  CHECK: press={p} steps={n}")
PY
fi
echo "DONE"
