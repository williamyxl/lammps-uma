#!/bin/bash -l
#PBS -N p6_p4run
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# P4 12-tile N=18: rebuild LAMMPS (mpi_peer AC merge) + run pair_style uma on 12
# tiles via XCCL GP with per-rank AC artifacts. Then parity vs ASE + step-0 forces.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
ART=${LU}/scripts/out/phase6_p4/blocks_ac_gp   # contains w12/r{R}/...
OUTDIR=${LU}/scripts/out/phase6_p4_run; mkdir -p "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"
echo "=== rebuild LAMMPS (mpi_peer AC merge) ==="
FORCE_REBUILD=1 bash "${LU}/scripts/phase6_build_lammps_xccl.sh" 2>&1 | tail -6
[ -x "${LMP}" ] || { echo "LMP BUILD FAILED"; exit 1; }
echo "LMP OK"
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=pmix CCL_ATL_TRANSPORT=mpi CCL_ZE_IPC_EXCHANGE=sockets FI_PROVIDER=cxi
# inputs: N=18, devices 1 (world = mpiexec ranks), pair_coeff points at ART (w12/r{R} appended by C++)
R=${OUTDIR}/nacl_n18_w12
OUTDIR="${R}" ART="${ART}" N=18 W=1 NVT_STEPS=0 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${R}/*/in.sp 2>/dev/null | head -1)); INF=in.sp
echo "rundir=${RD}"
echo "=== 12-tile N=18 GP run (mpiexec -n 12, XCCL, AC) ==="
t0=$SECONDS
( cd "${RD}" && mpiexec -n 12 --ppn 12 \
    env UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=46656 LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" \
    gpu_tile_compact.sh "${LMP}" -in "${INF}" > lmp.log 2>&1 )
rc=$?; W12=$((SECONDS-t0))
echo "12-tile exit=${rc} wall=${W12}s :: $(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1)"
grep -iE "ac_active|per-rank AC|loaded .*block|xccl.*ready|out of memory|OUT_OF|error|abort" ${RD}/lmp.log | grep -vi index_reduce | head -6
echo "=== parity vs ASE (energy + per-atom force >=100 atoms) ==="
DIR="${RD}" UMA_CKPT_FILE="${UMA_CHECKPOINT}" MIN_SAMPLE=100 E_TOL=1e-6 F_TOL=1e-5 \
  python -u "${LU}/scripts/phase5_parity.py" 2>&1 | grep -vi index_reduce | tail -6
echo "DONE"
