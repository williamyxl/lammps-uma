#!/bin/bash -l
#PBS -N p21_sc16
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k doe
# §5 regeneration: N=16 NVT 300K 10-step scaling on W=1,2,4,6,8,12, C1 and C2,
# using P2.1-padded artifacts (so the 10-step NVT no longer crashes). Reports
# wall + Loop time (proper MD timing) + step-0/step-10 PE per W.
set +u
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
LMP=${LU}/build-lmp-xccl/lmp
N=16; NAT=$((8*N*N*N))
ART1=${LU}/scripts/out/p21/n16_1tile
ARTG=${LU}/scripts/out/p21/n16
OUTDIR=${LU}/scripts/out/p21_scaling_n16; mkdir -p "${OUTDIR}"
source "${HEN}/scripts/activate_fxpu.sh"
set -euo pipefail
export PYTHONPATH="${ENG}/python:${HEN}/shim:${HEN}/patches:${HEN}:${PYTHONPATH:-}"
[ -x "${LMP}" ] || { echo "LMP MISSING"; exit 1; }
TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd \
       CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi

pe_at () {
python3 - "$1" "$2" <<'PYEOF'
import re,sys
try: txt=open(sys.argv[1]).read()
except: sys.exit()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
if not m: sys.exit()
hdr=m.group(0).split(); pe=hdr.index("PotEng")
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s and s[0]==sys.argv[2]: print(f"{float(s[pe]):.6f}"); break
PYEOF
}

run_w () {
  local W=$1 CFG=$2
  local NR=""; [ "${CFG}" = "C2" ] && NR="UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1"
  local ART; [ $W -eq 1 ] && ART="${ART1}" || ART="${ARTG}"
  local NRr; [ $W -eq 1 ] && NRr=$(ls ${ART}/model_traced.pt 2>/dev/null|wc -l) || NRr=$(ls -d ${ART}/w${W}/r*/model_traced.pt 2>/dev/null|wc -l)
  if [ "${NRr}" -lt "${W}" ]; then echo "P21SC W=${W} ${CFG}: artifacts ${NRr}/${W} MISSING"; return; fi
  [ $W -gt 1 ] && cp -f "${ART}/w${W}/r0/metadata.json" "${ART}/metadata.json"
  local RB=${OUTDIR}/w${W}_${CFG}; mkdir -p "${RB}"
  OUTDIR="${RB}" ART="${ART}" N=${N} W=${W} NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
  local RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))
  local t0=$SECONDS
  set +e
  if [ $W -eq 1 ]; then
    ( cd "${RD}" && mpiexec -n 1 --ppn 1 env ${NR} UMA_CHECKPOINT="${UMA_CHECKPOINT}" LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  else
    ( cd "${RD}" && mpiexec -n ${W} --ppn ${W} env ${NR} UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
  fi
  local rc=$?; set -e
  local WALL=$((SECONDS-t0))
  local LOOP=$(grep -oE 'Loop time of [0-9.]+ .* for 10 steps' ${RD}/log.lammps 2>/dev/null|grep -oE '[0-9.]+'|head -1)
  local OOM=$(grep -icE "out of memory|OUT_OF|UR_RESULT_ERROR" ${RD}/lmp.log 2>/dev/null)
  local PE0=$(pe_at "${RD}/log.lammps" 0); local PE10=$(pe_at "${RD}/log.lammps" 10)
  echo "P21SC N=16 W=${W} ${CFG} exit=${rc} oom=${OOM} wall=${WALL}s loop=${LOOP}s step0=${PE0} step10=${PE10}"
}

echo "### N=16 NVT-10 scaling (P2.1 padded) ###"
for W in 1 2 4 6 8 12; do
  run_w ${W} C1
  run_w ${W} C2
done
echo "DONE"
