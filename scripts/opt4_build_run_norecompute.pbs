#!/bin/bash -l
#PBS -N o4_norec
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:60:00
#PBS -j oe
#PBS -k doe
# opt4 (no-recompute fast path): rebuild lmp with the UMA_NO_RECOMPUTE knob in
# block_context.cpp, then run N=32 W=12 NVT 300K 10 steps with UMA_NO_RECOMPUTE=1
# (retain block/chunk activations, skip backward recompute). Reuses the opt2
# EDGE_AC_CHUNK=65536 artifacts (runtime-only change, no re-export). Compares
# energy (must be dE=0 vs -879646.224481715) and wall/Loop vs the 235 s baseline.
# Also prints a UMA_MP_PERF breakdown to confirm bwd shrank.
module reset 2>/dev/null || true
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
HEN_ROOT=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
LU=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/lammps-uma
ENG=${LU}/src/ML-UMA/uma-engine
N=${N:-32}; NAT=$((8*N*N*N))
ART=${ART:-${LU}/scripts/out/opt2/n32_chunk65536}
OUTDIR=${LU}/scripts/out/opt4run/n${N}; mkdir -p "${OUTDIR}"
source "${HEN_ROOT}/scripts/activate_fxpu.sh"
set -euo pipefail  # P3.2: strict mode (after activation)
export PYTHONPATH="${ENG}/python:${HEN_ROOT}/shim:${HEN_ROOT}/patches:${HEN_ROOT}:${PYTHONPATH:-}"

echo "=== 1) rebuild lmp with UMA_NO_RECOMPUTE knob ==="
bash "${LU}/scripts/phase6_build_lammps_xccl.sh" 2>&1 | tee "${OUTDIR}/build.log" | tail -8
LMP=${LU}/build-lmp-xccl/lmp
[ -x "${LMP}" ] || { echo "BUILD FAILED"; exit 1; }

TORCH_LIB=$(python -c "import torch,os;print(os.path.join(os.path.dirname(torch.__file__),'lib'))")
ICPX_LIB=$(dirname $(dirname $(which icpx)))/lib
COMPAT=${OUTDIR}/compat; mkdir -p "${COMPAT}"; ln -sf "${CONDA_PREFIX}/lib/libsycl.so.9" "${COMPAT}/libsycl.so.8"
export LD_LIBRARY_PATH="${COMPAT}:${CONDA_PREFIX}/lib:${TORCH_LIB}:${ICPX_LIB}:${LD_LIBRARY_PATH}"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT HF_HUB_OFFLINE=1 FAIRCHEM_OFFLINE=1 PYTHONUNBUFFERED=1
export UMA_CHECKPOINT="${HEN_ROOT}/uma-cache/uma-s-1p2.pt"
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=pidfd CCL_WORKER_COUNT=1 FI_PROVIDER=tcp CCL_KVS_MODE=mpi
# Recompute-skip selection (default: block+edge_degree only; chunk AC stays ON to
# fit HBM at N=32 W=12, since full UMA_NO_RECOMPUTE=1 OOMs). Override via NR_ENV.
NR_ENV=${NR_ENV:-"UMA_NO_RECOMPUTE_BLOCK=1 UMA_NO_RECOMPUTE_EDEG=1"}
[ -f "${ART}/w12/r0/metadata.json" ] && cp "${ART}/w12/r0/metadata.json" "${ART}/metadata.json"
echo "ART=${ART}  ranks: $(ls -d ${ART}/w12/r*/model_traced.pt 2>/dev/null|wc -l)/12  NR_ENV=[${NR_ENV}]"
RB=${OUTDIR}/run; mkdir -p "${RB}"
OUTDIR="${RB}" ART="${ART}" N=${N} W=1 NVT_STEPS=10 python -u "${LU}/scripts/phase6_make_gp_inputs.py" >/dev/null 2>&1
RD=$(dirname $(ls ${RB}/*/in.sp 2>/dev/null|head -1))

echo "=== 2) run pair_style uma NVT N=${N} (12 tiles) [${NR_ENV}] ==="
t0=$SECONDS
( cd "${RD}" && mpiexec -n 12 --ppn 12 env ${NR_ENV} UMA_MP_PERF=1 UMA_CHECKPOINT="${UMA_CHECKPOINT}" UMA_MP_NATOMS=${NAT} LD_LIBRARY_PATH="${LD_LIBRARY_PATH}" gpu_tile_compact.sh "${LMP}" -in in.sp > lmp.log 2>&1 )
rc=$?; WALL=$((SECONDS-t0))
echo "N=${N} 12-tile exit=${rc} wall=${WALL}s :: step0 $(grep -E '^\s*0\s' ${RD}/log.lammps 2>/dev/null|head -1)"
grep -iE "out of memory|OUT_OF|abort" ${RD}/lmp.log | grep -vi index_reduce | head -3
echo "NVT last step: $(grep -E '^\s*10\s' ${RD}/log.lammps 2>/dev/null|tail -1)"
echo "Loop time: $(grep -E 'Loop time of .* for 10 steps' ${RD}/log.lammps 2>/dev/null|head -1)"
echo "=== step-10 PE (ref = -879646.224481715 eV, opt1+opt3 wall 235 s / loop 179.975 s) ==="
python3 - "${RD}/log.lammps" <<'PYEOF'
import re,sys
try: txt=open(sys.argv[1]).read()
except OSError: sys.exit()
m=re.search(r"^\s*Step\b.*PotEng.*$",txt,re.M)
if not m: sys.exit()
hdr=m.group(0).split(); pe=hdr.index("PotEng"); last=None
for ln in txt[m.end():].splitlines():
    s=ln.split()
    if len(s)>=len(hdr) and s and s[0].isdigit(): last=s
if last:
    e=float(last[pe]); ref=-879646.224481715
    print(f"  step={last[0]}  PE={e:.9f} eV  dE={abs(e-ref):.3e} eV  {'PASS' if abs(e-ref)<1e-4 else 'FAIL'}")
PYEOF
echo "=== per-call MP_PERF avg (expect bwd much smaller than 12047 ms) ==="
python3 - "${RD}/lmp.log" <<'PYEOF'
import re,sys,statistics as st
rows=[]
for ln in open(sys.argv[1],errors='ignore'):
    m=re.search(r"ms_graph=([\d.]+) ms_fwd=([\d.]+) ms_bwd=([\d.]+) ms_force_ar=([\d.]+) ms_total=([\d.]+)",ln)
    if m: rows.append([float(x) for x in m.groups()])
if rows:
    names=["graph","fwd","bwd","force_ar","total"]
    for i,nm in enumerate(names):
        v=[r[i] for r in rows]; print(f"  {nm:9s} mean={st.mean(v):8.1f} ms  (n={len(rows)})")
else: print("  (no MP_PERF)")
PYEOF
echo "OPT4_RESULT N=${N} atoms=${NAT} exit=${rc} wall=${WALL}s NO_RECOMPUTE=1"
echo "DONE"
